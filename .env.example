# ===========================================
# Supabase Environment Variables
# ===========================================
# Copy file ini ke .env lalu isi nilainya
#
# Cara setup:
# 1. Buka https://supabase.com/dashboard/project/ejyqtuzlcdnuuzgqfweo/settings/api
# 2. Copy "Project URL" → NEXT_PUBLIC_SUPABASE_URL
# 3. Copy "anon public" → NEXT_PUBLIC_SUPABASE_ANON_KEY
# 4. Copy "service_role secret" → SUPABASE_SERVICE_ROLE_KEY (hati-hati!)
# 5. Buka https://supabase.com/dashboard/account/tokens
# 6. Klik "New Access Token", beri nama, copy → SUPABASE_PAT
# ===========================================

# Supabase - API Keys (sudah diisi, hanya untuk local dev)
# Jangan commit file ini ke GitHub!
NEXT_PUBLIC_SUPABASE_URL=https://ejyqtuzlcdnuuzgqfweo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVqeXF0dXpsY2RudXV6Z3Fmd2VvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyNDQzMDAsImV4cCI6MjA5NjgyMDMwMH0.x8lX4hFsvOAbkUx0PHou-DsIKJ4nWNfD_2QFBGmgwYQ

# ⚠️ Isi SUPABASE_PAT untuk bisa jalankan SQL migration otomatis
# Cara dapat PAT: https://supabase.com/dashboard/account/tokens → New Access Token
# Lalu POST ke http://localhost:3000/api/migrate
SUPABASE_PAT=

